{
  "manifest_version": 3,
  "default_locale": "en",

  "name": "__MSG_extension_name__",
  "description": "__MSG_extension_description__",
  "version": "1.0",

  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },

  "background": {
    "scripts": ["js/core/background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "js": [
        "js/lib/jquery.js",
        "js/core/tools.js",
        "js/core/common.js",
        "js/core/hoverzoom.js",
        "js/plugins/default.js",
        "js/core/content.js"
      ],
      "matches": ["<all_urls>"],
      "run_at": "document_end"
    },
    {
      "js": ["js/plugins/reddit.js"],
      "matches": ["*://*.reddit.com/*"],
      "run_at": "document_end"
    },
    {
      "js": ["js/plugins/twitter.js"],
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.tweetdeck.com/*"
      ],
      "run_at": "document_end"
    },
    {
      "js": ["js/plugins/amazon.js"],
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.com.au/*",
        "*://*.amazon.com.br/*",
        "*://*.amazon.com.mx/*",
        "*://*.amazon.com.tr/*",
        "*://*.amazon.ae/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.cn/*",
        "*://*.amazon.de/*",
        "*://*.amazon.eg/*",
        "*://*.amazon.es/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.co.jp/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.in/*",
        "*://*.amazon.it/*",
        "*://*.amazon.nl/*",
        "*://*.amazon.sg/*"
      ],
      "run_at": "document_end"
    },
    {
      "js": ["js/plugins/google.js"],
      "matches": [
        "*://*.google.com/*",
        "*://*.google.co.uk/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.es/*",
        "*://*.google.it/*",
        "*://*.google.co.jp/*",
        "*://*.google.co.in/*",
        "*://*.google.com.br/*",
        "*://*.google.com.mx/*",
        "*://*.google.nl/*",
        "*://*.google.pl/*",
        "*://*.google.ru/*",
        "*://*.google.co.kr/*",
        "*://*.google.se/*",
        "*://*.google.ch/*",
        "*://*.google.at/*",
        "*://*.google.be/*"
      ],
      "run_at": "document_end"
    },
    {
      "js": ["js/plugins/instagram.js"],
      "matches": ["*://*.instagram.com/*"],
      "run_at": "document_end"
    },
    {
      "js": ["js/plugins/facebook.js"],
      "matches": ["*://*.facebook.com/*"],
      "run_at": "document_end"
    },
    {
      "js": ["js/plugins/pinterest.js"],
      "matches": [
        "*://*.pinterest.com/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.jp/*",
        "*://*.pinterest.co.kr/*",
        "*://*.pinterest.nl/*",
        "*://*.pinterest.ch/*",
        "*://*.pinterest.at/*",
        "*://*.pinterest.co.nz/*",
        "*://*.pinterest.com.mx/*",
        "*://*.pinterest.se/*",
        "*://*.pinterest.dk/*",
        "*://*.pinterest.pt/*",
        "*://*.pinterest.ru/*",
        "*://*.pinterest.ie/*",
        "*://*.pinterest.fi/*",
        "*://*.pinterest.cz/*",
        "*://*.pinterest.co.in/*"
      ],
      "run_at": "document_end"
    },
    {
      "js": ["js/plugins/flickr.js"],
      "matches": ["*://*.flickr.com/*", "*://*.flickr.net/*"],
      "run_at": "document_end"
    },
    {
      "js": [
        "js/plugins/mediawiki_a.js",
        "js/plugins/flickr_a.js",
        "js/plugins/imgur_a.js",
        "js/plugins/facebook_a.js",
        "js/plugins/google_a.js",
        "js/plugins/instagram_a.js",
        "js/plugins/twitter_a.js",
        "js/plugins/youtube_a.js"
      ],
      "matches": ["<all_urls>"],
      "run_at": "document_end"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": "images/toolbar-icon.svg"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "permissions": ["storage", "activeTab"],

  "host_permissions": ["<all_urls>"],

  "web_accessible_resources": [
    {
      "resources": ["images/loading.svg", "images/spectrogram.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
